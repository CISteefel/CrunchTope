TITLE
ShortCourse7.in: Tracer test involving diffusion
END
 
RUNTIME
time_units         days
timestep_max       0.005
timestep_init      0.00000001
time_tolerance      0.001
debye-huckel        true
database_sweep      false
speciate_only       false
lag_activity        false
gimrt               true
graphics            kaleidagraph
master_variable     Tracer
hindmarsh           true
solver              direct
PC                  ilu
PClevel             10
GIMRT_PC            bjacobi
GIMRT_PClevel       0
GIMRT_solver        gmres
screen_output       50
ResidualTolerance   1.0E-08
END

DATABASE
datacom.dbs
END
 
OUTPUT
time_units           days
spatial_profile      1  2  3  4  5  
time_series          TracerDiffusion7.out  251 
time_series_print    Tracer
time_series_interval 1
END

TRANSPORT
distance_units meters
time_units  second
fix_diffusion  1.E-09
dispersivity   0.0
END

BOUNDARY_CONDITIONS
!!! BoundaryCondition      junk2   zone   0-0       1-1     1-1  flux
!!! BoundaryCondition      junk2    zone  502-502   1-1     1-1  flux
x_begin   junk2           flux
x_end     junk2           flux
END

INITIAL_CONDITIONS
junk2   1-501    1-1  1-1
junk1   251-251  1-1  1-1
END

Condition junk1
units            mol/kg
set_porosity     0.99
temperature      25.0
Tracer           0.1
Na+              0.001
Cl-              0.0015
H2O              55.50843506
END

Condition junk2
units            mol/kg
set_porosity     0.99
temperature      25.0
Tracer           0.00001
Na+              0.001
Cl-              0.0015
H2O              55.50843506
END

DISCRETIZATION
xzones 501 0.0002
END
 
FLOW
time_units       years
distance_units   meters
constant_flow    0.0
END
 
POROSITY
fix_porosity     0.99
END
 
PRIMARY_SPECIES
H2O
Na+
Cl-
Tracer
END
 

 
