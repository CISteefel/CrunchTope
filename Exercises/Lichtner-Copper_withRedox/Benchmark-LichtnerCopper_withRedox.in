TITLE
Peter Lichtner's 2D copper leaching problem
END

DATABASE
copper.dbs
END

RUNTIME
time_units          days
timestep_max        0.005
timestep_init       1.d-13
correction_max      2.0
time_tolerance      0.0001
debye-huckel        true
database_sweep      false
speciate_only       false
lag_activity        false
gimrt               true
graphics            tecplot
master_variable     O2(aq)
hindmarsh           false
solver              direct
PC                  ilu
PClevel             5
GIMRT_PC            bjacobi
GIMRT_PClevel       0
GIMRT_solver        gmres
screen_output       50
ResidualTolerance   1.0E-08
aqueousdatabase     Fe_redox_aqueous_v5_5_kunits.dbs
save_restart        coppersulfide1.rst
END

OUTPUT
time_units               years
spatial_profile_at_time  1.50  2.00 2.50 3.00
!!! 0.1  0.50  1.0  
!!! 1.50  2.00 2.50 3.00
time_series_at_node      CopperLeach.out  30 30 1
time_series_at_node      output1.out        2 2 1
time_series_at_node      output2.out        3 3 1

time_series_print        Cu++  pH
time_series_interval     1  
!!!MakeMovie       true
END

MINERALS
Pyrite          -label williamson          -rate  -8.9 
Pyrite          -label testing_inhibition  -rate  -8.9
Chalcopyrite    -label acero               -rate -5.52
Chalcocite      -label simpleTST           -rate -9.00
Covellite       -label simpleTST           -rate -6.00
Bornite         -label simpleTST           -rate -5.30
Digenite        -label simpleTST           -rate -7.00

Goethite    -label default   -rate  -8.00 
Kaolinite   -label default   -rate  -39.00 
Muscovite   -label default   -rate  -39.00
Quartz      -label default   -rate  -10.00
SiO2(am)    -label default   -rate  -7.00
Gypsum      -label default   -rate  -6.00
Jarosite    -label default   -rate  -37.00
Jurbanite   -label default   -rate  -37.00 
Alunite     -label default   -rate  -37.00 
END

DISCRETIZATION 
xzones  30   0.5 
yzones  30   0.5
END

AQUEOUS_KINETICS
FeII_oxidation                               ![base]
!!! HS_O2_oxidation                              ![base]
!!! HS_Fe3_oxidation                             ![base]
END
 
Condition initial_condition Initial condition for simulation 
temperature      25.0
porosity         0.05
Na+              0.01
K+               1.0E-06
Ca++             6.8513E-04
pH               5.5
Cu++             1.0E-06
Al+++            Kaolinite           
Fe+++            Goethite
Fe++             1.D-06
SiO2(aq)         1.8703E-04
HCO3-            CO2(g)    0.001    
SO4--            5.0e-04   
Cl-              0.01   
O2(aq)           O2(g)    1.D-10
Tracer           0.0001
H2O              55.50843506

Chalcopyrite     0.05  100.0
Pyrite           0.05  100.0
Chalcocite       0.00  100.0

Covellite        0.00  1.0
Bornite          0.00  1.0
Digenite         0.00  1.0

Goethite         0.00  100.0
Kaolinite        0.05  100.0
Muscovite        0.05  100.0
Quartz           0.82  100.0
SiO2(am)         0.0   100.0
Gypsum           0.0   100.0
Jarosite         0.0   100.0
Jurbanite        0.0   100.0
Alunite          0.0   100.0
END

Condition leach_solution    Composition of leach solution at injection well
temperature     25.0
set_porosity    0.05
Na+             0.01  
K+              1.d-06
Ca++            1.d-06
pH              1.d0 
pH              3.d0
Cu++            1.0e-10  
Al+++           1.0-10
Fe+++           1.d-10
Fe++            1.D-20
SiO2(aq)        1.d-06
HCO3-           CO2(g)    0.01 
SO4--           1.d-01 
Cl-             0.01     
O2(aq)          O2(g)     0.1
Tracer          0.01
H2O             55.50843506

Chalcopyrite     0.05  1.0
Pyrite           0.05  1.0
Chalcocite       0.00  1.0

Covellite        0.00  1.0
Bornite          0.00  1.0
Digenite         0.00  1.0

Goethite         0.00  1.0
Kaolinite        0.0   1.0
Muscovite        0.0   1.0
Quartz           0.8   1.0
SiO2(am)         0.0    1.0
Gypsum           0.0    1.0
Jarosite         0.0    1.0
Jurbanite        0.0    1.0
Alunite          0.0    1.0
END

INITIAL_CONDITIONS
initial_condition  1-30  1-30   1-1
END

BOUNDARY_CONDITIONS
X_begin   initial_condition  Flux 
X_end     initial_condition  Flux 
Y_begin   initial_condition  Flux 
Y_end     initial_condition  Flux 
END

TRANSPORT
time_units      seconds
distance_units  meters
diffusion       1.d-10
dispersivity    0.01   0.0
END

FLOW
time_units          years
distance_units      meters
calculate_flow      true
!!! constant_flow       1.0  0.0         !!! Only use this if you do NOT want to calculate flow
permeability_X      1.5e-13  default
permeability_Y      1.5e-13  default 
permeability_X      1000.d0    zone  0-0    1-30  1-1
permeability_X      0.d0    zone  31-31  1-30  1-1
permeability_Y      0.d0    zone  1-30   31-31 1-1
permeability_Y      0.d0    zone  1-30   0-0   1-1   
pressure            1.0      default 
!!!pressure            1000.0  zone  0-0  1-30  1-1
pumpunits           liter_sec
pump                0.1   leach_solution     1   1  1
pump               -0.1   leach_solution    30  30  1        !!! NOTE: Leach solution not used for a production well 
gravity             90.0  90.0  90.0  down 
END

POROSITY
fix_porosity     0.05
porosity_update  false
END

TEMPERATURE
set_temperature  25.0
END

PRIMARY_SPECIES
H2O
Na+
K+
Ca++
H+
Cu++
Al+++
Fe+++
Fe++
SiO2(aq)
HCO3-
SO4--
Cl-
O2(aq)
END

SECONDARY_SPECIES
!!! Fe++
HS-
H2S(aq)
S--
HSO4-
H2SO4(aq)
Al(OH)2+
!!Al(SO4)2-
!!AlO2-
AlOH++
!!! AlSO4+
CO2(aq)
CO3--
CaCO3(aq)
CaHCO3+
CaOH+
CaSO4(aq)
CuCl+
CuCl2(aq)
CuCl3--
CuCl4--
CuO2--
CuOH+
CuSO4(aq)
!CaCl+
!CaCl2(aq)
!FeCl+
!FeCl2(aq)
!FeCl4--
!FeOH+
Fe(OH)2(aq)
Fe(OH)2+
Fe(OH)3(aq)
Fe(OH)3-
Fe(OH)4-
!Fe(OH)4--
FeSO4(aq)
FeSO4+
Fe(SO4)2-
H2SiO4--
HAlO2(aq)
OH-
Cu+
END

GASES
O2(g)
H2S(g)
CO2(g)
END

!!AQUEOUS_KINETICS
!!END

ION_EXCHANGE
END

SURFACE_COMPLEXATION
END

